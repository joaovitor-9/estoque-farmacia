# Copie este arquivo para secrets.toml (local) ou cole o conteúdo em
# "Settings > Secrets" do Streamlit Cloud. NUNCA publique o secrets.toml.

APP_PASSWORD = "troque-por-uma-senha"   # senha para entrar no sistema
SHEET_ID = "id-da-planilha-na-url"      # entre /d/ e /edit na URL do Google Sheets
# MODO_DEMO = true                      # use só com uma planilha de dados fictícios

[gcp_service_account]
# Cole aqui os campos do arquivo JSON baixado do Google Cloud:
type = "service_account"
project_id = ""
private_key_id = ""
private_key = ""
client_email = ""
client_id = ""
token_uri = "https://oauth2.googleapis.com/token"
